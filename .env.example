# Modelos (formato init_chat_model provider:modelo). Default: openai:gpt-6-luna em todos os agentes (app/models.py).
# MODEL=                      # so o orquestrador
# MODEL_ARCHITECT=
# MODEL_ANGULAR_CODER=
# MODEL_MAX_RETRIES=5
# MAX_FIX_ROUNDS=5            # rodadas de correcao apos ngc --noEmit falhar (cada uma custa ~US$ 0,01 e 10-40 s)
# FRONTEND_CHECK=1            # 0 desliga ngc/ng build (requer npm)
# FRONTEND_DEST=~/Codes/deepagents_jobapplier/frontend   # onde o Angular final e gravado
# UX_RUNS_DIR=~/UX Project/ux-deep-agents/workspace/runs  # runs do ux-deep-agents (--latest-ux-run)
OPENAI_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=frontend-builder
